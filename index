                package: item['分装'],
                price: item['售价'],
                img: item['图片'],
                sysQty: sysQty,
                realQty: sysQty // 默认实盘数量 = 账面数量
            };
        });
    }

    let currentFilter = 'all';

    function saveLocal() {
        try {
            localStorage.setItem('wenzhou_stock_counts', JSON.stringify(stockData));
        } catch(e){}
    }

    function updateStats() {
        let total = stockData.length;
        let match = 0;
        let less = 0;
        let more = 0;

        stockData.forEach(item => {
            const diff = item.realQty - item.sysQty;
            if (diff === 0) match++;
            else if (diff < 0) less++;
            else if (diff > 0) more++;
        });

        document.getElementById('statTotal').innerText = total;
        document.getElementById('statMatch').innerText = match;
        document.getElementById('statLess').innerText = less;
        document.getElementById('statMore').innerText = more;
    }

    function render() {
        updateStats();
        const query = document.getElementById('searchInput').value.trim().toLowerCase();

        const filtered = stockData.filter(item => {
            const matchQuery = (item.name && item.name.toLowerCase().includes(query)) ||
                               (item.sku && item.sku.toLowerCase().includes(query));
            if (!matchQuery) return false;

            const diff = item.realQty - item.sysQty;
            if (currentFilter === 'diff') return diff !== 0;
            if (currentFilter === 'less') return diff < 0;
            if (currentFilter === 'more') return diff > 0;
            return true;
        });

        const cardView = document.getElementById('cardView');
        if (filtered.length === 0) {
            cardView.innerHTML = `<div style="text-align:center; padding:40px; color:#94a3b8; font-size:14px;">没有符合条件的商品</div>`;
            return;
        }

        cardView.innerHTML = filtered.map(item => {
            const diff = item.realQty - item.sysQty;
            let cardClass = 'card diff-equal';
            let diffTag = `<span class="diff-tag tag-equal">无差异</span>`;

            if (diff < 0) {
                cardClass = 'card diff-less';
                diffTag = `<span class="diff-tag tag-less">少 ${Math.abs(diff)}</span>`;
            } else if (diff > 0) {
                cardClass = 'card diff-more';
                diffTag = `<span class="diff-tag tag-more">多 ${diff}</span>`;
            }

            const hasImg = item.img && item.img.trim().length > 0 && item.img !== '/';
            const imgHtml = hasImg 
                ? `<img src="${escapeHtml(item.img)}" referrerpolicy="no-referrer" class="card-thumb" onclick="openModal('${escapeHtml(item.img)}', '${escapeHtml(item.name)} - ${escapeHtml(item.sku)}')">`
                : `<div class="card-thumb-placeholder">无图</div>`;

            return `
                <div class="${cardClass}">
                    <div class="card-header">
                        ${imgHtml}
                        <div class="card-info">
                            <div class="card-title">${escapeHtml(item.name)}</div>
                            <div class="card-sku">SKU: ${escapeHtml(item.sku)}</div>
                            <div class="card-meta">包装: ${escapeHtml(item.package || '-')} | 售价: ${escapeHtml(item.price || '-')}</div>
                        </div>
                    </div>

                    <div class="stock-control-row">
                        <div class="system-qty">账面: <b>${item.sysQty}</b></div>
                        
                        <div class="counter-box">
                            <span style="font-size:12px; color:#64748b; margin-right:4px;">实盘:</span>
                            <button class="btn-counter" onclick="adjustQty(${item.id}, -1)">-</button>
                            <input type="number" class="input-counter" value="${item.realQty}" onchange="setQty(${item.id}, this.value)">
                            <button class="btn-counter" onclick="adjustQty(${item.id}, 1)">+</button>
                        </div>

                        ${diffTag}
                    </div>
                </div>
            `;
        }).join('');
    }

    function adjustQty(id, delta) {
        const item = stockData.find(x => x.id === id);
        if (item) {
            item.realQty = Math.max(0, item.realQty + delta);
            saveLocal();
            render();
        }
    }

    function setQty(id, val) {
        const item = stockData.find(x => x.id === id);
        if (item) {
            const num = parseInt(val);
            item.realQty = isNaN(num) ? 0 : Math.max(0, num);
            saveLocal();
            render();
        }
    }

    function setFilter(filter, btn) {
        currentFilter = filter;
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        render();
    }

    function resetAllCounts() {
        if (confirm('确认将所有商品的实盘数量重置为账面数量吗？')) {
            stockData.forEach(item => item.realQty = item.sysQty);
            saveLocal();
            render();
        }
    }

    function exportExcelReport() {
        let csvContent = "\uFEFF产品名称,SKU规格,包装,售价,账面数量,实盘数量,差异(盈亏),盘点状态\n";
        
        stockData.forEach(item => {
            const diff = item.realQty - item.sysQty;
            let status = '正常';
            if (diff < 0) status = '盘亏(缺货)';
            if (diff > 0) status = '盘盈(多出)';

            csvContent += `"${item.name}","${item.sku}","${item.package}","${item.price}",${item.sysQty},${item.realQty},${diff},"${status}"\n`;
        });

        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `9.4-6温州盘点差异报告_${new Date().toLocaleDateString()}.csv`;
        a.click();
        alert('🎉 盘点差异报告已导出！可以发送给负责人核对！');
    }

    function openModal(src, caption) {
        document.getElementById('modalImg').src = src;
        document.getElementById('modalCaption').innerText = caption;
        document.getElementById('imgModal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('imgModal').style.display = 'none';
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.toString()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    render();
</script>

</body>
</html>
